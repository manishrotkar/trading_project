# ============================================================
# Tiny To-Do — environment configuration
# ============================================================
# Copy this file to .env and fill in real values locally:
#
#     cp .env.example .env
#
# .env is gitignored — never commit real values.
# Only placeholders belong here. This project is standard
# library only, so there is no automatic .env loader; export
# the variables manually or set them inline for a single run.

# ------------------------------------------------------------
# TODO_DATA_FILE
# ------------------------------------------------------------
# Where tasks.json lives. Defaults to data/tasks.json when unset.
# Read by todo/storage.py.
# TODO_DATA_FILE=data/tasks.json

# ------------------------------------------------------------
# ACCESS_TOKEN_FILE
# ------------------------------------------------------------
# Where auth_main.py looks for the access token.
# Defaults to access.txt when unset.
# ACCESS_TOKEN_FILE=access.txt

# ------------------------------------------------------------
# Fyers API credentials — loaded locally by fyers/credentials.py
# ------------------------------------------------------------
# Read by fyers_main.py / fyers.credentials.load_credentials().
# The process environment wins over these file values, so a one-off
# override is always possible:  FYERS_APP_ID=xxx python fyers_main.py verify
# Placeholders only — real values go in your local .env.
FYERS_APP_ID=your-app-id-here
FYERS_CLIENT_ID=your-client-id-here
FYERS_ACCESS_TOKEN=your-access-token-here
FYERS_SECRET_KEY=your-secret-key-here
